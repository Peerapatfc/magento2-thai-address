{
    "name": "peerapatfc/magento2-thai-address",
    "description": "Thai provinces as Magento regions, postal code lookup (REST and GraphQL) and server-side address validation for checkout",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": ["magento2", "magento", "thailand", "thai", "address", "postcode", "checkout"],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.7",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-directory": "*",
        "magento/module-graph-ql": "*",
        "magento/module-webapi": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Peerapatfc\\ThaiAddress\\": ""
        }
    }
}
