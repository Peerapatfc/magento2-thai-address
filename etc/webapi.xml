<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/thai-address/postcode/:postcode" method="GET">
        <service class="Peerapatfc\ThaiAddress\Api\AddressLookupInterface" method="getByPostcode"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/thai-address/provinces" method="GET">
        <service class="Peerapatfc\ThaiAddress\Api\AreaListInterface" method="getProvinces"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/thai-address/provinces/:provinceCode/districts" method="GET">
        <service class="Peerapatfc\ThaiAddress\Api\AreaListInterface" method="getDistricts"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/thai-address/districts/:districtCode/subdistricts" method="GET">
        <service class="Peerapatfc\ThaiAddress\Api\AreaListInterface" method="getSubdistricts"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
